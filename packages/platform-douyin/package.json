{
  "name": "@ksgames26/platform-douyin",
  "version": "0.1.0",
  "description": "Douyin Mini Game platform adapter",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/pixijs-game-framework.git",
    "directory": "packages/platform-douyin"
  },
  "bugs": {
    "url": "https://github.com/your-org/pixijs-game-framework/issues"
  },
  "homepage": "https://github.com/your-org/pixijs-game-framework/tree/main/packages/platform-douyin#readme",
  "keywords": [
    "pixi",
    "pixijs",
    "game",
    "framework",
    "platform",
    "douyin",
    "minigame"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": [
    "./src/inject.ts",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@ksgames26/core": "workspace:*"
  },
  "devDependencies": {
    "@ksgames26/core": "workspace:*"
  },
  "dependencies": {
    "@douyin-microapp/typings": "^1.3.1"
  }
}
