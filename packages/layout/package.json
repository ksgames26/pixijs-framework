{
  "name": "@ksgames26/layout",
  "version": "0.1.0",
  "description": "Flexbox layout for PixiJS using @pixi/layout",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksgames26/pixijs-framework.git",
    "directory": "packages/layout"
  },
  "bugs": {
    "url": "https://github.com/ksgames26/pixijs-framework/issues"
  },
  "homepage": "https://github.com/ksgames26/pixijs-framework/tree/main/packages/layout#readme",
  "keywords": ["pixi", "pixijs", "layout", "flexbox", "ui"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "pixi.js": ">=8.0.0",
    "@pixi/layout": ">=2.0.0"
  },
  "devDependencies": {
    "pixi.js": "^8.13.0",
    "@pixi/layout": "^2.0.0"
  }
}
