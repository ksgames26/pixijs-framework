{
  "name": "@ksgames26/spine",
  "version": "0.1.0",
  "description": "Spine animation module for PixiJS game framework",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksgames26/pixijs-framework.git",
    "directory": "packages/spine"
  },
  "bugs": {
    "url": "https://github.com/ksgames26/pixijs-framework/issues"
  },
  "homepage": "https://github.com/ksgames26/pixijs-framework/tree/main/packages/spine#readme",
  "keywords": ["pixi", "pixijs", "game", "framework", "spine", "animation"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "pixi.js": ">=8.16.0",
    "@ksgames26/core": "workspace:*",
    "@ksgames26/assets": "workspace:*"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "~4.2.0"
  },
  "devDependencies": {
    "pixi.js": "^8.16.0",
    "@ksgames26/core": "workspace:*",
    "@ksgames26/assets": "workspace:*"
  }
}
